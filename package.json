{
  "name": "bullet-wake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BULLET WAKE — original cinematic horizontal arcade shooter",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "assets:generate": "node scripts/generate-sprites.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.0.0"
  }
}
